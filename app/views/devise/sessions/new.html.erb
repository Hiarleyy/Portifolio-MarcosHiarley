<div class="login-card">
  <div class="login-header">
    <span class="brand-icon">&lt;/&gt;</span>
    <h1>Admin Login</h1>
    <p>Entre com suas credenciais para acessar o painel.</p>
  </div>

  <% if alert %>
    <div class="flash flash-alert">
      <i class="ph ph-warning-circle"></i>
      <span><%= alert %></span>
    </div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>
    <div class="form-group">
      <label for="admin_user_email" class="form-label">Email</label>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "admin@portfolio.com", id: "admin_user_email" %>
    </div>

    <div class="form-group">
      <label for="admin_user_password" class="form-label">Senha</label>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-input", placeholder: "••••••••", id: "admin_user_password" %>
    </div>

    <div class="form-group">
      <label class="form-checkbox">
        <%= f.check_box :remember_me %>
        <span class="checkmark"></span>
        Lembrar de mim
      </label>
    </div>

    <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
  <% end %>

  <div class="login-footer">
    <a href="<%= root_path %>">← Voltar ao site</a>
  </div>
</div>
