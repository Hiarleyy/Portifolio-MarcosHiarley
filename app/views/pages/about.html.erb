    </div>

    <div class="timeline">
      <div class="timeline-item fade-in">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-date"><%= t("about.experiences.evolutec.date") %></span>
          <h3><%= t("about.experiences.evolutec.role") %></h3>
          <p class="timeline-company"><%= t("about.experiences.evolutec.company") %></p>
          <p><%= t("about.experiences.evolutec.desc") %></p>
        </div>
      </div>

      <div class="timeline-item fade-in">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-date"><%= t("about.experiences.ufpa_health.date") %></span>
          <h3><%= t("about.experiences.ufpa_health.role") %></h3>
          <p class="timeline-company"><%= t("about.experiences.ufpa_health.company") %></p>
