<!DOCTYPE html>
<html lang="<%= I18n.locale == :en ? 'en' : 'pt-BR' %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} — #{t('site.title_suffix')}" : t('site.default_title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : (content_for?(:description) ? yield(:description) : t('site.default_description')) %>">
    <meta charset="utf-8">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Swiper 11 CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- Phosphor Icons (CSS font delivery — works with Rails CSP) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/bold/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css" />

    <!-- Devicon — Technology Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Background mesh gradient -->
    <div class="bg-mesh"></div>

    <div class="content-wrapper">
      <!-- Navbar -->
      <nav class="navbar" id="main-navbar">
        <div class="container">
          <%= link_to "Marcos Hiarley", root_path, class: "navbar-brand" %>

          <div class="navbar-right-group">
            <!-- Language Switcher (Desktop & Mobile) -->
            <div class="lang-switcher" aria-label="Language Selector">
              <%= link_to url_for(request.query_parameters.merge(locale: :pt)), class: "lang-btn #{I18n.locale.to_s.start_with?('pt') ? 'active' : ''}", title: "Português" do %>
                <span class="lang-flag">🇧🇷</span>
                <span class="lang-code">PT</span>
              <% end %>
              <span class="lang-divider">/</span>
              <%= link_to url_for(request.query_parameters.merge(locale: :en)), class: "lang-btn #{I18n.locale == :en ? 'active' : ''}", title: "English" do %>
                <span class="lang-flag">🇺🇸</span>
                <span class="lang-code">EN</span>
              <% end %>
            </div>

            <button class="navbar-toggle" id="navbar-toggle" aria-label="<%= t('nav.toggle_navigation') %>">
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>

          <ul class="navbar-nav" id="navbar-nav">
            <li><%= link_to t("nav.home"), root_path, class: current_page?(root_path) ? "active" : "" %></li>
            <li><%= link_to t("nav.blog"), articles_path, class: current_page?(articles_path) ? "active" : "" %></li>
            <li><%= link_to t("nav.projects"), projects_path, class: current_page?(projects_path) ? "active" : "" %></li>
            <li><%= link_to t("nav.about"), about_path, class: current_page?(about_path) ? "active" : "" %></li>
            <li><%= link_to t("nav.contact"), contact_path, class: current_page?(contact_path) ? "active" : "" %></li>
          </ul>
        </div>
      </nav>

      <!-- Flash Messages -->
      <% if notice || alert %>
        <div class="flash-container">
          <% if notice %>
            <div class="flash-message flash-notice"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="flash-message flash-alert"><%= alert %></div>
          <% end %>
        </div>
      <% end %>

      <!-- Main Content -->
      <main>
        <%= yield %>
      </main>

      <!-- Footer -->
      <footer class="footer">
        <div class="container">
          <div class="footer-content">
            <span class="footer-brand">Marcos Hiarley</span>
            <ul class="footer-links">
              <li><%= link_to t("nav.home"), root_path %></li>
              <li><%= link_to t("nav.blog"), articles_path %></li>
              <li><%= link_to t("nav.projects"), projects_path %></li>
              <li><%= link_to t("nav.about"), about_path %></li>
              <li><%= link_to t("nav.contact"), contact_path %></li>
            </ul>
            <span class="footer-copy">&copy; <%= Date.today.year %> Marcos Hiarley. <%= t("site.all_rights_reserved") %></span>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Mobile nav toggle
      document.getElementById('navbar-toggle').addEventListener('click', function() {
        document.getElementById('navbar-nav').classList.toggle('open');
      });

      // Scroll animations
      document.addEventListener('DOMContentLoaded', function() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>
