<% content_for(:title) { t("articles.title") } %>
<% content_for(:meta_description) { t("articles.meta_description") } %>

<section class="page-header">
  <div class="container">
    <h1 class="page-title fade-in"><%= t("articles.page_title_prefix") %> <span class="gradient-text"><%= t("articles.page_title_highlight") %></span></h1>
    <p class="page-subtitle fade-in"><%= t("articles.subtitle") %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if @articles.any? %>
      <div class="articles-grid articles-grid-full">
        <% @articles.each_with_index do |article, index| %>
          <a href="<%= article_path(article.localized_slug) %>" class="article-card fade-in" style="animation-delay: <%= index * 0.05 %>s">
            <div class="article-image">
              <% if article.cover_image.attached? %>
                <%= image_tag article.cover_image, alt: article.localized_title %>
              <% else %>
                <div class="article-placeholder">
                  <i class="ph ph-article"></i>
                </div>
              <% end %>
              <% if article.featured? %>
                <span class="article-badge"><%= t("articles.featured_badge") %></span>
              <% end %>
            </div>
            <div class="article-info">
              <div class="article-meta">
                <span class="article-date"><i class="ph ph-calendar"></i> <%= article.formatted_date %></span>
                <span class="article-reading"><i class="ph ph-clock"></i> <%= t("articles.reading_time", count: article.reading_time) %></span>
              </div>
              <h3 class="article-title"><%= article.localized_title %></h3>
              <p class="article-excerpt"><%= article.localized_excerpt %></p>
              <span class="article-read-more"><%= t("articles.read_more") %> <i class="ph ph-arrow-right"></i></span>
            </div>
          </a>
        <% end %>
      </div>

      <!-- Pagination -->
      <div class="pagination-wrapper fade-in">
        <%= paginate @articles %>
      </div>
    <% else %>
      <div class="empty-state fade-in">
        <i class="ph ph-article"></i>
        <h3><%= t("articles.empty_title") %></h3>
        <p><%= t("articles.empty_desc") %></p>
      </div>
    <% end %>
  </div>
</section>
