<% content_for(:title) { t("about.title") } %>
<% content_for(:meta_description) { t("about.meta_description") } %>

<section class="page-header">
  <div class="container">
    <h1 class="page-title fade-in"><%= t("about.title").split.first %> <span class="gradient-text"><%= t("about.title").split.drop(1).join(" ") %></span></h1>
    <p class="page-subtitle fade-in"><%= t("about.header_subtitle") %></p>
  </div>
</section>

<section class="section"
  data-controller="magnetic-dots"
  data-magnetic-dots-dot-size-value="1.5"
  data-magnetic-dots-dot-spacing-value="28"
  data-magnetic-dots-attraction-radius-value="160"
  data-magnetic-dots-attraction-strength-value="0.3"
  data-magnetic-dots-spring-strength-value="0.05"
  data-magnetic-dots-damping-value="0.85"
  data-magnetic-dots-dot-color-value="rgba(160, 160, 160, 0.30)"
  data-magnetic-dots-flow-angle-value="25"
  data-magnetic-dots-flow-speed-value="0.02"
  data-magnetic-dots-flow-amplitude-value="15">
  <div class="container">
    <div class="about-grid">
      <div class="about-content fade-in">
        <h2><%= t("about.heading") %></h2>
        <p><%= t("about.bio_p1_html").html_safe %></p>
        <p><%= t("about.bio_p2_html").html_safe %></p>
        <p><%= t("about.bio_p3_html").html_safe %></p>

        <div class="about-actions">
          <a href="<%= asset_path('Curriculo_pt_br.pdf') %>" download="Curriculo_Marcos_Hiarley_PT.pdf" class="btn btn-primary">
            <i class="ph ph-file-pdf"></i> <%= t("about.download_cv_pt") %>
          </a>
          <a href="<%= asset_path('Curriculo_ENG.pdf') %>" download="Resume_Marcos_Hiarley_EN.pdf" class="btn btn-primary">
            <i class="ph ph-file-pdf"></i> <%= t("about.download_cv_en") %>
          </a>
          <a href="https://www.linkedin.com/in/marcoshiarley" target="_blank" rel="noopener" class="btn btn-outline">
            <i class="ph ph-linkedin-logo"></i> LinkedIn
          </a>
        </div>
      </div>

      <div class="about-image fade-in">
        <div class="about-photo-frame">
          <%= image_tag "profile.jpg", alt: "Marcos Hiarley", class: "about-photo" %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Skills Section -->
<section class="section section-alt">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag"><i class="ph ph-lightning"></i> <%= t("about.skills_tag") %></span>
      <h2 class="section-title"><%= t("about.skills_title") %></h2>
    </div>

    <div class="skills-grid">
      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-diamond"></i></div>
        <h3><%= t("about.skills.rails_title") %></h3>
        <p><%= t("about.skills.rails_desc") %></p>
        <div class="skill-bar"><div class="skill-fill" style="width: 92%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-atom"></i></div>
        <h3><%= t("about.skills.react_title") %></h3>
        <p><%= t("about.skills.react_desc") %></p>
        <div class="skill-bar"><div class="skill-fill" style="width: 90%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-coffee"></i></div>
        <h3><%= t("about.skills.java_title") %></h3>
        <p><%= t("about.skills.java_desc") %></p>
        <div class="skill-bar"><div class="skill-fill" style="width: 88%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-database"></i></div>
        <h3><%= t("about.skills.pg_title") %></h3>
        <p><%= t("about.skills.pg_desc") %></p>
        <div class="skill-bar"><div class="skill-fill" style="width: 90%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-wifi-high"></i></div>
        <h3><%= t("about.skills.networks_title") %></h3>
        <p><%= t("about.skills.networks_desc") %></p>
        <div class="skill-bar"><div class="skill-fill" style="width: 85%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-docker-logo"></i></div>
        <h3><%= t("about.skills.docker_title") %></h3>
        <p><%= t("about.skills.docker_desc") %></p>
        <div class="skill-bar"><div class="skill-fill" style="width: 87%"></div></div>
      </div>
    </div>
  </div>
</section>

