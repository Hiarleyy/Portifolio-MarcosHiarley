<% content_for(:title) { "Sobre Mim" } %>
<% content_for(:meta_description) { "Conheça mais sobre Marcos Hiarley, desenvolvedor full stack e pesquisador na UFPA." } %>

<section class="page-header">
  <div class="container">
    <h1 class="page-title fade-in">Sobre <span class="gradient-text">Marcos Hiarley</span></h1>
    <p class="page-subtitle fade-in">Desenvolvedor Full Stack & Pesquisador em Ciência da Computação</p>
  </div>
</section>

<section class="section"
  data-controller="magnetic-dots"
  data-magnetic-dots-dot-size-value="1.5"
  data-magnetic-dots-dot-spacing-value="28"
  data-magnetic-dots-attraction-radius-value="160"
  data-magnetic-dots-attraction-strength-value="0.3"
  data-magnetic-dots-spring-strength-value="0.05"
  data-magnetic-dots-damping-value="0.85"
  data-magnetic-dots-dot-color-value="rgba(160, 160, 160, 0.30)"
  data-magnetic-dots-flow-angle-value="25"
  data-magnetic-dots-flow-speed-value="0.02"
  data-magnetic-dots-flow-amplitude-value="15">
  <div class="container">
    <div class="about-grid">
      <div class="about-content fade-in">
        <h2>Quem sou eu</h2>
        <p>
          Sou <strong>Marcos Hiarley</strong>, desenvolvedor Full Stack e pesquisador vinculado à
          <strong>Faculdade de Computação (FACOMP)</strong> da <strong>Universidade Federal do Pará (UFPA)</strong>.
          Combino rigor acadêmico e engenharia de software prática para criar aplicações web modernas, escaláveis e eficientes.
        </p>
        <p>
          No desenvolvimento de software, atuo com ferramentas como <strong>Ruby on Rails</strong>, <strong>PostgreSQL</strong>,
          <strong>React</strong>, <strong>JavaScript</strong>, <strong>Java</strong> e <strong>Docker</strong>.
          Minha experiência abrange desde a modelagem de banco de dados e APIs RESTful até interfaces responsivas de alto desempenho.
        </p>
        <p>
          Na área de pesquisa, dedico-me a estudos avançados em <strong>Computação de Alto Desempenho (HPC)</strong>,
          transmissão sem fio em altas frequências para redes <strong>5G e 6G</strong>, simulações em <strong>NS-3</strong> e Internet das Coisas (IoT).
        </p>

        <div class="about-actions">
          <a href="/curriculo_marcos_hiarley.pdf" download class="btn btn-primary">
            <i class="ph ph-file-pdf"></i> Baixar CV
          </a>
          <a href="https://www.linkedin.com/in/marcoshiarley" target="_blank" rel="noopener" class="btn btn-outline">
            <i class="ph ph-linkedin-logo"></i> LinkedIn
          </a>
        </div>
      </div>

      <div class="about-image fade-in">
        <div class="about-photo-frame">
          <%= image_tag "profile.jpg", alt: "Foto de perfil de Marcos Hiarley", class: "about-photo" %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Skills Section -->
<section class="section section-alt">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag"><i class="ph ph-lightning"></i> Habilidades</span>
      <h2 class="section-title">Minhas Tecnologias & Competências</h2>
    </div>

    <div class="skills-grid">
      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-diamond"></i></div>
        <h3>Ruby on Rails</h3>
        <p>Desenvolvimento backend, APIs RESTful escaláveis, arquitetura de software e bancos de dados relacionais.</p>
        <div class="skill-bar"><div class="skill-fill" style="width: 92%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-atom"></i></div>
        <h3>React & JavaScript</h3>
        <p>Criação de interfaces web dinâmicas, componentes responsivos, ES6+, Stimulus.js e integração com APIs.</p>
        <div class="skill-bar"><div class="skill-fill" style="width: 90%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-coffee"></i></div>
        <h3>Java & Engenharia de Software</h3>
        <p>Programação orientada a objetos, estruturas de dados avançadas e desenvolvimento de sistemas.</p>
        <div class="skill-bar"><div class="skill-fill" style="width: 88%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-database"></i></div>
        <h3>PostgreSQL</h3>
        <p>Modelagem relacional, otimização de queries SQL, índices avançados e persistência de dados.</p>
        <div class="skill-bar"><div class="skill-fill" style="width: 90%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-wifi-high"></i></div>
        <h3>Redes & Simulações (5G/6G)</h3>
        <p>Pesquisa acadêmica, simulações em NS-3, protocolos de comunicação sem fio e IoT.</p>
        <div class="skill-bar"><div class="skill-fill" style="width: 85%"></div></div>
      </div>

      <div class="skill-card fade-in">
        <div class="skill-icon"><i class="ph ph-docker-logo"></i></div>
        <h3>Docker & DevOps</h3>
        <p>Containerização de aplicações, ambientes isolados, versionamento com Git e GitHub.</p>
        <div class="skill-bar"><div class="skill-fill" style="width: 87%"></div></div>
      </div>
    </div>
  </div>
</section>

<!-- Experience Timeline -->
<section class="section">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag"><i class="ph ph-briefcase"></i> Trajetória</span>
      <h2 class="section-title">Minha Jornada Acadêmica & Profissional</h2>
    </div>

    <div class="timeline">
      <div class="timeline-item fade-in">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-date">2023 - Presente</span>
          <h3>Pesquisador & Desenvolvedor na UFPA</h3>
          <p>Atuação em projetos de Computação de Alto Desempenho, simulação de redes sem fio 5G/6G em NS-3 e publicação de artigos em conferências de computação (ERAD/SBC).</p>
        </div>
      </div>

      <div class="timeline-item fade-in">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-date">2022 - Presente</span>
          <h3>Desenvolvedor Full Stack</h3>
          <p>Construção de ecossistemas web e mobile com Ruby on Rails, PostgreSQL, React, JavaScript e Java para soluções sob medida.</p>
        </div>
      </div>

      <div class="timeline-item fade-in">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-date">Engenharia de Computação (FACOMP/UFPA)</span>
          <h3>Graduação na Universidade Federal do Pará</h3>
          <p>Formação acadêmica focada em arquitetura de computadores, inteligência artificial, redes de computadores e algoritmos.</p>
        </div>
      </div>
    </div>
  </div>
</section>
