<% content_for(:title) { @article.localized_title } %>
<% content_for(:meta_description) { @article.localized_excerpt } %>

<article class="article-show">
  <!-- Article Header -->
  <header class="article-header">
    <div class="container container-narrow">
      <a href="<%= articles_path %>" class="back-link fade-in">
        <i class="ph ph-arrow-left"></i> <%= t("articles.back_to_blog") %>
      </a>

      <div class="article-meta-full fade-in">
        <span><i class="ph ph-calendar"></i> <%= @article.formatted_date %></span>
        <span><i class="ph ph-clock"></i> <%= t("articles.reading_time", count: @article.reading_time) %></span>
      </div>

      <h1 class="article-show-title fade-in"><%= @article.localized_title %></h1>

      <% if @article.localized_excerpt.present? %>
        <p class="article-show-excerpt fade-in"><%= @article.localized_excerpt %></p>
      <% end %>
    </div>

    <% if @article.cover_image.attached? %>
      <div class="article-cover fade-in">
        <div class="container">
          <%= image_tag @article.cover_image, alt: @article.localized_title, class: "article-cover-img" %>
        </div>
      </div>
    <% end %>
  </header>

  <!-- Article Body -->
  <div class="article-body fade-in">
    <div class="container container-narrow">
      <div class="article-content prose">
        <%= markdown(@article.localized_body) %>
      </div>

      <% if @article.content_images.attached? %>
        <div class="article-gallery">
          <h3><%= t("articles.gallery_heading") %></h3>
          <div class="gallery-grid">
            <% @article.content_images.each do |image| %>
              <div class="gallery-item">
                <%= image_tag image, alt: "Imagem do artigo" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Related Articles -->
  <% if @related_articles.any? %>
    <section class="section section-alt">
      <div class="container">
        <div class="section-header fade-in">
          <h2 class="section-title"><%= t("articles.related_heading") %></h2>
        </div>

        <div class="articles-grid">
          <% @related_articles.each do |article| %>
            <a href="<%= article_path(article.localized_slug) %>" class="article-card fade-in">
              <div class="article-image">
                <% if article.cover_image.attached? %>
                  <%= image_tag article.cover_image, alt: article.localized_title %>
                <% else %>
                  <div class="article-placeholder">
                    <i class="ph ph-article"></i>
                  </div>
                <% end %>
              </div>
              <div class="article-info">
                <div class="article-meta">
                  <span class="article-date"><i class="ph ph-calendar"></i> <%= article.formatted_date %></span>
                </div>
                <h3 class="article-title"><%= article.localized_title %></h3>
                <p class="article-excerpt"><%= article.localized_excerpt %></p>
              </div>
            </a>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</article>
