<%
  raw_projects = local_assigns[:projects] || @featured_projects || @projects || []
  projects = raw_projects.to_a

  if projects.empty?
    projects = [
      {
        title: "Simulação de Redes 5G/6G & HPC",
        category: "Pesquisa UFPA & Alto Desempenho",
        description: "Ambiente de simulação em NS-3 para transmissão sem fio em altas frequências, alocação de rádio base aéreos e modelagem de tráfego móvel.",
        technologies: "NS-3, Python, C++, Linux, HPC",
        live_url: "https://www.linkedin.com/in/marcoshiarley",
        github_url: "https://github.com/Hiarleyy/Ns-3-simulations"
      },
      {
        title: "Plataforma Web Full Stack",
        category: "Engenharia de Software Web",
        description: "Aplicação completa construída com Ruby on Rails e PostgreSQL, contando com autenticação, APIs RESTful e componentes reativos.",
        technologies: "Ruby on Rails, PostgreSQL, React, Docker, JavaScript",
        live_url: "https://www.linkedin.com/in/marcoshiarley",
        github_url: "https://github.com/Hiarleyy"
      },
      {
        title: "Sistema IoT & Telemetria em Tempo Real",
        category: "Internet das Coisas & Mobile",
        description: "Plataforma de monitoramento de sensores e dispositivos inteligentes com sincronização em tempo real e visualização de métricas.",
        technologies: "Java, JavaScript, WebSockets, HTML/CSS, Docker",
        live_url: "https://www.linkedin.com/in/marcoshiarley",
        github_url: "https://github.com/Hiarleyy"
      }
    ]
  end
%>

<div class="parallax-hero-slider" data-controller="slider" data-slider-total-value="<%= projects.length %>">
  <!-- Swiper container -->
  <div class="swiper" data-slider-target="container">
    <div class="swiper-wrapper">
      <% projects.each_with_index do |project, idx| %>
        <%
          index_str = sprintf("%02d", idx + 1)
          title = project.respond_to?(:title) ? project.title : project[:title]
          description = project.respond_to?(:description) ? project.description : project[:description]
          category = (project.respond_to?(:category) && project.category.present?) ? project.category : (project.is_a?(Hash) ? project[:category] : "Projeto em Destaque")
          technologies = project.respond_to?(:technologies) ? project.technologies : project[:technologies]
          live_url = project.respond_to?(:live_url) ? project.live_url : project[:live_url]
          github_url = project.respond_to?(:github_url) ? project.github_url : project[:github_url]
          screenshot_attached = project.respond_to?(:screenshot) && project.screenshot.respond_to?(:attached?) && project.screenshot.attached?
        %>
        <div class="swiper-slide">
          <!-- Background image + parallax -->
          <div class="slide-bg" data-swiper-parallax="-15%">
            <% if screenshot_attached %>
              <%= image_tag project.screenshot, alt: title, class: "slide-bg-img" %>
            <% else %>
              <div class="slide-bg-placeholder">
                <i class="ph ph-code"></i>
              </div>
            <% end %>
            <div class="slide-overlay-radial"></div>
            <div class="slide-overlay-bottom"></div>
          </div>

          <!-- Slide Content -->
          <div class="slide-content-container">
            <div class="slide-content-inner">
              <!-- Index & Category -->
              <div class="slide-header-meta" data-swiper-parallax="-100">
                <span class="slide-index"><%= index_str %></span>
                <span class="slide-divider"></span>
                <span class="slide-category"><%= category %></span>
              </div>

              <!-- Title -->
              <h1 class="slide-title" data-swiper-parallax="-200">
                <%= title %>
              </h1>

              <!-- Description -->
              <p class="slide-description" data-swiper-parallax="-300">
                <%= description %>
              </p>

              <!-- Tech Stack Badges -->
              <div class="slide-tech-stack" data-swiper-parallax="-350">
                <% technologies.to_s.split(",").each do |tech| %>
                  <span class="tech-pill"><%= tech.strip %></span>
                <% end %>
              </div>

              <!-- Action Buttons -->
              <div class="slide-actions" data-swiper-parallax="-400">
                <% if live_url.present? %>
                  <a href="<%= live_url %>" target="_blank" rel="noopener" class="btn btn-slider-primary">
                    <span>Ver projeto</span>
                    <svg class="icon-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                <% end %>

                <% if github_url.present? %>
                  <a href="<%= github_url %>" target="_blank" rel="noopener" class="btn btn-slider-outline">
                    <svg class="icon-github" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
                    </svg>
                    <span>Código</span>
                  </a>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Bottom Controls Bar -->
  <div class="slider-bottom-controls">
    <!-- Pagination dots & Progress circles -->
    <div class="slider-pagination-wrap">
      <% projects.each_with_index do |_, idx| %>
        <button type="button"
                class="slider-dot-btn <%= 'active' if idx.zero? %>"
                data-slider-target="dot"
                data-index="<%= idx %>"
                data-action="click->slider#goTo"
                aria-label="Ir para o projeto <%= idx + 1 %>">
          <span class="dot-core"></span>
          <svg class="dot-ring" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" class="ring-bg" />
            <circle cx="12" cy="12" r="10" class="ring-fill" data-slider-target="progressCircle" />
          </svg>
        </button>
      <% end %>

      <span class="slider-counter" data-slider-target="counter">
        01 / <%= sprintf("%02d", projects.length) %>
      </span>
    </div>

    <!-- Navigation Arrows -->
    <div class="slider-nav-btns">
      <button type="button" class="slider-nav-btn" data-action="click->slider#prev" aria-label="Projeto anterior">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button type="button" class="slider-nav-btn" data-action="click->slider#next" aria-label="Próximo projeto">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</div>
