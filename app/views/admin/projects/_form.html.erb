<%= form_with(model: [:admin, project], class: "admin-form", local: true) do |f| %>
  <% if project.errors.any? %>
    <div class="form-errors">
      <h3><i class="ph ph-warning"></i> <%= pluralize(project.errors.count, "erro encontrado", "erros encontrados") %>:</h3>
      <ul>
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-grid">
    <div class="admin-form-main">
      <div class="admin-card">
        <h3 class="admin-card-title">Informações do Projeto (Português 🇧🇷)</h3>

        <div class="form-group">
          <label for="project_title" class="form-label">Título (PT) *</label>
          <%= f.text_field :title, class: "form-input", placeholder: "Nome do projeto em português", required: true, id: "project_title" %>
        </div>

        <div class="form-group">
          <label for="project_description" class="form-label">Descrição (PT) *</label>
          <%= f.text_area :description, class: "form-input form-textarea form-textarea-lg", placeholder: "Descreva o projeto em português...", rows: 8, required: true, id: "project_description" %>
        </div>

        <div class="form-group">
          <label for="project_technologies" class="form-label">Tecnologias</label>
          <%= f.text_field :technologies, class: "form-input", placeholder: "Ruby on Rails, PostgreSQL, Docker (separadas por vírgula)", id: "project_technologies" %>
          <span class="form-hint">Separe as tecnologias com vírgula.</span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="project_live_url" class="form-label">URL do Projeto</label>
            <%= f.url_field :live_url, class: "form-input", placeholder: "https://meuapp.com", id: "project_live_url" %>
          </div>

          <div class="form-group">
            <label for="project_github_url" class="form-label">URL do GitHub</label>
            <%= f.url_field :github_url, class: "form-input", placeholder: "https://github.com/user/repo", id: "project_github_url" %>
          </div>
        </div>
      </div>

      <div class="admin-card" style="margin-top: 1.5rem;">
        <h3 class="admin-card-title">Informações em Inglês (English 🇺🇸)</h3>

        <div class="form-group">
          <label for="project_title_en" class="form-label">Título em Inglês (Title EN)</label>
          <%= f.text_field :title_en, class: "form-input", placeholder: "Project name in English", id: "project_title_en" %>
        </div>

        <div class="form-group">
          <label for="project_description_en" class="form-label">Descrição em Inglês (Description EN)</label>
          <%= f.text_area :description_en, class: "form-input form-textarea form-textarea-lg", placeholder: "Describe the project in English...", rows: 8, id: "project_description_en" %>
        </div>
      </div>
    </div>

    <div class="admin-form-sidebar">
      <div class="admin-card">
        <h3 class="admin-card-title">Opções</h3>

        <div class="form-group">
          <label class="form-checkbox">
            <%= f.check_box :featured, id: "project_featured" %>
            <span class="checkmark"></span>
            Projeto em destaque
          </label>
        </div>

        <div class="form-group">
          <label for="project_position" class="form-label">Posição</label>
          <%= f.number_field :position, class: "form-input", min: 0, value: project.position || 0, id: "project_position" %>
          <span class="form-hint">Ordem de exibição (menor = primeiro).</span>
        </div>
      </div>

      <div class="admin-card">
        <h3 class="admin-card-title">Screenshot</h3>

        <div class="form-group">
          <div class="file-upload">
            <% if project.screenshot.attached? %>
              <div class="file-preview">
                <%= image_tag project.screenshot, class: "file-preview-img" %>
              </div>
            <% end %>
            <div class="file-upload-area">
              <i class="ph ph-cloud-arrow-up"></i>
              <p>Clique ou arraste uma imagem</p>
              <span class="form-hint">JPEG, PNG ou WebP (máx 10MB)</span>
            </div>
            <%= f.file_field :screenshot, accept: "image/jpeg,image/png,image/webp", class: "file-input", id: "project_screenshot" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit project.persisted? ? "Atualizar Projeto" : "Criar Projeto", class: "btn btn-primary" %>
    <a href="<%= admin_projects_path %>" class="btn btn-outline">Cancelar</a>
  </div>
<% end %>
