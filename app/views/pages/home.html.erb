<% content_for(:title) { t("nav.home") } %>

<!-- About Preview Section -->
<section class="section home-about-section" id="sobre"
  data-controller="magnetic-dots"
  data-magnetic-dots-dot-size-value="1.5"
  data-magnetic-dots-dot-spacing-value="28"
  data-magnetic-dots-attraction-radius-value="160"
  data-magnetic-dots-attraction-strength-value="0.3"
  data-magnetic-dots-spring-strength-value="0.05"
  data-magnetic-dots-damping-value="0.85"
  data-magnetic-dots-dot-color-value="rgba(160, 160, 160, 0.30)"
  data-magnetic-dots-flow-angle-value="25"
  data-magnetic-dots-flow-speed-value="0.02"
  data-magnetic-dots-flow-amplitude-value="15">
  <div class="container">
    <div class="home-about-grid">
      <div class="home-about-photo fade-in">
        <div class="home-photo-frame">
          <%= image_tag "profile.jpg", alt: "Marcos Hiarley", class: "home-profile-img" %>
          <div class="home-photo-glow"></div>
        </div>
        <div class="home-about-badges">
          <span class="home-badge"><i class="ph ph-graduation-cap"></i> UFPA</span>
          <span class="home-badge"><i class="ph ph-map-pin"></i> Belém, PA</span>
        </div>
      </div>

      <div class="home-about-content fade-in">
        <span class="section-tag"><i class="ph ph-user"></i> <%= t("home.about_preview.tag") %></span>
        <h2 class="home-about-title"><%= t("home.about_preview.title_prefix") %> <span class="gradient-text">Marcos Hiarley</span></h2>
        <p class="home-about-desc">
          <%= t("home.about_preview.bio_p1_html").html_safe %>
        </p>
        <p class="home-about-desc">
          <%= t("home.about_preview.bio_p2_html").html_safe %>
        </p>

        <div class="home-stats-row">
          <div class="home-stat">
            <span class="home-stat-num"><%= t("home.about_preview.stats.experience_value") %></span>
            <span class="home-stat-label"><%= t("home.about_preview.stats.experience_label") %></span>
          </div>
          <div class="home-stat">
            <span class="home-stat-num"><%= t("home.about_preview.stats.projects_value") %></span>
            <span class="home-stat-label"><%= t("home.about_preview.stats.projects_label") %></span>
          </div>
          <div class="home-stat">
            <span class="home-stat-num"><%= t("home.about_preview.stats.publications_value") %></span>
            <span class="home-stat-label"><%= t("home.about_preview.stats.publications_label") %></span>
          </div>
        </div>

        <div class="home-about-actions">
          <a href="<%= about_path %>" class="btn btn-primary">
            <i class="ph ph-user-circle"></i> <%= t("home.about_preview.view_profile") %>
          </a>
          <a href="https://github.com/Hiarleyy" target="_blank" rel="noopener" class="btn btn-outline">
            <i class="ph ph-github-logo"></i> <%= t("home.about_preview.github") %>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- Projetos em Destaque -->
<section class="section section-projects" id="projetos">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag"><i class="ph ph-briefcase"></i> <%= t("home.projects_section.tag") %></span>
      <h2 class="section-title"><%= t("home.projects_section.title") %></h2>
      <p class="section-subtitle"><%= t("home.projects_section.subtitle") %></p>
    </div>
  </div>

  <%= render "shared/parallax_slider", projects: @featured_projects %>

  <div class="container">
    <div class="section-action fade-in">
      <a href="<%= projects_path %>" class="btn btn-outline">
        <%= t("home.projects_section.view_all") %> <i class="ph ph-arrow-right"></i>
      </a>
    </div>
  </div>
</section>



<!-- Skills Highlights Section -->
<section class="section" id="habilidades"
  data-controller="magnetic-dots"
  data-magnetic-dots-dot-size-value="1.5"
  data-magnetic-dots-dot-spacing-value="30"
  data-magnetic-dots-attraction-radius-value="140"
  data-magnetic-dots-attraction-strength-value="0.25"
  data-magnetic-dots-spring-strength-value="0.05"
  data-magnetic-dots-damping-value="0.85"
  data-magnetic-dots-dot-color-value="rgba(150, 150, 150, 0.25)"
  data-magnetic-dots-flow-angle-value="20"
  data-magnetic-dots-flow-speed-value="0.018"
  data-magnetic-dots-flow-amplitude-value="12">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag"><i class="ph ph-lightning"></i> <%= t("home.skills_section.tag") %></span>
      <h2 class="section-title"><%= t("home.skills_section.title") %></h2>
      <p class="section-subtitle"><%= t("home.skills_section.subtitle") %></p>
    </div>

    <div class="home-skills-grid">
      <div class="home-skill-card fade-in">
        <div class="home-skill-header">
          <div class="home-skill-icon ruby-icon">
            <i class="devicon-rails-plain"></i>
          </div>
          <div>
            <h3>Ruby on Rails</h3>
            <span class="home-skill-level"><%= t("home.skills_section.level_expert") %></span>
          </div>
        </div>
        <div class="skill-bar"><div class="skill-fill" style="width: 92%"></div></div>
        <p><%= t("home.skills_section.rails_desc") %></p>
      </div>

      <div class="home-skill-card fade-in">
        <div class="home-skill-header">
          <div class="home-skill-icon react-icon">
            <i class="devicon-react-original"></i>
          </div>
          <div>
            <h3>React & JavaScript</h3>
            <span class="home-skill-level"><%= t("home.skills_section.level_advanced") %></span>
          </div>
        </div>
        <div class="skill-bar"><div class="skill-fill" style="width: 90%"></div></div>
        <p><%= t("home.skills_section.react_desc") %></p>
      </div>

      <div class="home-skill-card fade-in">
        <div class="home-skill-header">
          <div class="home-skill-icon pg-icon">
            <i class="devicon-postgresql-plain"></i>
          </div>
          <div>
            <h3>PostgreSQL</h3>
            <span class="home-skill-level"><%= t("home.skills_section.level_advanced") %></span>
          </div>
        </div>
        <div class="skill-bar"><div class="skill-fill" style="width: 90%"></div></div>
        <p><%= t("home.skills_section.pg_desc") %></p>
      </div>

      <div class="home-skill-card fade-in">
        <div class="home-skill-header">
          <div class="home-skill-icon java-icon">
            <i class="devicon-java-plain"></i>
          </div>
          <div>
            <h3>Java & Docker</h3>
            <span class="home-skill-level"><%= t("home.skills_section.level_advanced_88") %></span>
          </div>
        </div>
        <div class="skill-bar"><div class="skill-fill" style="width: 88%"></div></div>
        <p><%= t("home.skills_section.java_desc") %></p>
      </div>

      <div class="home-skill-card fade-in">
        <div class="home-skill-header">
          <div class="home-skill-icon docker-icon">
            <i class="devicon-docker-plain"></i>
          </div>
          <div>
            <h3>Docker & DevOps</h3>
            <span class="home-skill-level"><%= t("home.skills_section.level_advanced_87") %></span>
          </div>
        </div>
        <div class="skill-bar"><div class="skill-fill" style="width: 87%"></div></div>
        <p><%= t("home.skills_section.docker_desc") %></p>
      </div>

      <div class="home-skill-card fade-in">
        <div class="home-skill-header">
          <div class="home-skill-icon linux-icon">
            <i class="devicon-linux-plain"></i>
          </div>
          <div>
            <h3>HPC & Linux</h3>
            <span class="home-skill-level"><%= t("home.skills_section.level_research") %></span>
          </div>
        </div>
        <div class="skill-bar"><div class="skill-fill" style="width: 85%"></div></div>
        <p><%= t("home.skills_section.hpc_desc") %></p>
      </div>
    </div>
  </div>
</section>


<!-- Recent Articles -->
<section class="section" id="artigos">
  <div class="container">
    <div class="section-header fade-in">
      <span class="section-tag"><i class="ph ph-article"></i> <%= t("home.articles_section.tag") %></span>
      <h2 class="section-title"><%= t("home.articles_section.title") %></h2>
      <p class="section-subtitle"><%= t("home.articles_section.subtitle") %></p>
    </div>

    <div class="articles-grid">
      <% @recent_articles.each_with_index do |article, index| %>
        <a href="<%= article_path(article.localized_slug) %>" class="article-card fade-in" style="animation-delay: <%= index * 0.1 %>s">
          <div class="article-image">
            <% if article.cover_image.attached? %>
              <%= image_tag article.cover_image, alt: article.localized_title %>
            <% else %>
              <div class="article-placeholder">
                <i class="ph ph-article"></i>
              </div>
            <% end %>
          </div>
          <div class="article-info">
            <div class="article-meta">
              <span class="article-date"><i class="ph ph-calendar"></i> <%= article.formatted_date %></span>
              <span class="article-reading"><i class="ph ph-clock"></i> <%= t("home.articles_section.reading_time", count: article.reading_time) %></span>
            </div>
            <h3 class="article-title"><%= article.localized_title %></h3>
            <p class="article-excerpt"><%= article.localized_excerpt %></p>
          </div>
        </a>
      <% end %>
    </div>

    <div class="section-action fade-in">
      <a href="<%= articles_path %>" class="btn btn-outline">
        <%= t("home.articles_section.view_all") %> <i class="ph ph-arrow-right"></i>
      </a>
    </div>
  </div>
</section>


<!-- CTA Section -->
<section class="section cta-section">
  <div class="container">
    <div class="cta-card fade-in">
      <div class="cta-avatar-wrapper">
        <%= image_tag "avatar.gif", alt: "CTA Image", class: "cta-avatar" %>
      </div>
      
      <div class="cta-content">
        <h2 class="cta-title"><%= t("home.cta.title") %></h2>
        <p class="cta-text"><%= t("home.cta.text") %></p>
      </div>

      <div class="cta-action">
        <a href="<%= contact_path %>" class="btn btn-primary btn-lg">
          <i class="ph ph-rocket"></i> <%= t("home.cta.button") %>
        </a>
      </div>
    </div>
  </div>
</section>
